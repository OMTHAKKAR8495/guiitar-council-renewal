# ==========================================
# GUIITAR Council — Environment Variables
# ==========================================

# Supabase Project Configuration (Client & Browser accessible)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Supabase Database Direct / Pooling Connections (Backend & Migration scripts only)
# IMPORTANT: Never commit actual database passwords or service keys to git.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Service Role Key (Backend & Migration scripts ONLY - NEVER expose to browser/client)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key
